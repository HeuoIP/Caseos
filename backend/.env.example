# Sample environment configuration for CaseOS backend.
# This file is committed; do NOT put real secrets here. Copy this file to
# `backend/.env` and fill in your own values. The `.env` file is git-ignored.

# Qwen (DashScope) Vision/Text API key.
QWEN_API_KEY=sk-your-key-here

# Optional overrides.
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# QWEN_VL_MODEL=qwen3.7-plus
# QWEN_TEXT_MODEL=qwen3.6-plus
